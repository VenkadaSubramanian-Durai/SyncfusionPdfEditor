{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syncfusion PDF Editor",
  "version": "0.1.0",
  "identifier": "com.syncfusion.pdfeditor.sample",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Syncfusion PDF Editor",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF document",
        "description": "PDF document",
        "role": "Editor"
      }
    ],
    "category": "Productivity",
    "shortDescription": "Free PDF editor built on Syncfusion PDF Viewer"
  }
}
