# Syncfusion license key used by `registerLicense` in src/license.ts.
# Without a valid key the app still runs, but the Syncfusion trial banner is shown.
VITE_SYNCFUSION_LICENSE=your-syncfusion-license-key

# Set to "true" to disable Syncfusion telemetry in release builds.
VITE_DISABLE_TELEMETRY=false
